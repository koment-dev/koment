{
  "description": "koment policy guidance and guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading koment policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "koment agents hook pre-tool",
            "timeout": 10,
            "statusMessage": "Checking for explanatory comments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "koment agents hook stop",
            "timeout": 30,
            "statusMessage": "Checking koment policy"
          }
        ]
      }
    ]
  }
}
